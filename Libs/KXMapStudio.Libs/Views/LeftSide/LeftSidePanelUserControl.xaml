<UserControl x:Class="KXMapStudio.Libs.Views.LeftSide.LeftSidePanelUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:workshopExplorer="clr-namespace:KXMapStudio.Libs.Views.LeftSide.WorkshopExplorer"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
	<Border Style="{StaticResource Kx.PanelSurface}">
		<workshopExplorer:WorkspaceExplorerUserControl DataContext="{Binding WorkshopExplorer}" />
	</Border>
</UserControl>