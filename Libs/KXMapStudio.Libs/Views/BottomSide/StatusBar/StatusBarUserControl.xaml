<UserControl x:Class="KXMapStudio.Libs.Views.BottomSide.StatusBar.StatusBarUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="26" d:DesignWidth="900">


	<Border Padding="12,5"
	        Background="{StaticResource MaterialDesign.Brush.Surface}"
	        BorderBrush="{StaticResource MaterialDesign.Brush.Separator}"
	        BorderThickness="0,1,0,0">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<!-- Connection Status Indicator: 3-state system with smooth animations -->
			<Grid Grid.Column="0" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
				<!-- Outer glow ring for visual depth -->
				<Ellipse Width="16" Height="16">
					<Ellipse.Style>
						<Style TargetType="Ellipse">
							<Setter Property="Fill">
								<Setter.Value>
									<RadialGradientBrush>
										<GradientStop Color="#33E53935" Offset="0" />
										<GradientStop Color="#00E53935" Offset="1" />
									</RadialGradientBrush>
								</Setter.Value>
							</Setter>
							<Style.Triggers>
								<!-- Red glow for Disconnected -->
								<DataTrigger Binding="{Binding ConnectionState}" Value="Disconnected">
									<Setter Property="Fill">
										<Setter.Value>
											<RadialGradientBrush>
												<GradientStop Color="#33E53935" Offset="0" />
												<GradientStop Color="#00E53935" Offset="1" />
											</RadialGradientBrush>
										</Setter.Value>
									</Setter>
								</DataTrigger>
								<!-- Yellow glow for Stale -->
								<DataTrigger Binding="{Binding ConnectionState}" Value="Stale">
									<Setter Property="Fill">
										<Setter.Value>
											<RadialGradientBrush>
												<GradientStop Color="#33FBC02D" Offset="0" />
												<GradientStop Color="#00FBC02D" Offset="1" />
											</RadialGradientBrush>
										</Setter.Value>
									</Setter>
								</DataTrigger>
								<!-- Green glow for Connected -->
								<DataTrigger Binding="{Binding ConnectionState}" Value="Connected">
									<Setter Property="Fill">
										<Setter.Value>
											<RadialGradientBrush>
												<GradientStop Color="#334CAF50" Offset="0" />
												<GradientStop Color="#004CAF50" Offset="1" />
											</RadialGradientBrush>
										</Setter.Value>
									</Setter>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Ellipse.Style>
				</Ellipse>

				<!-- Main status dot -->
				<Ellipse Width="10" Height="10">
					<Ellipse.Style>
						<Style TargetType="Ellipse">
							<!-- Default: Red (Disconnected) - no animation -->
							<Setter Property="Fill" Value="#E53935" />
							<Setter Property="Opacity" Value="1" />
							<Style.Triggers>
								<!-- Yellow (Stale) - slow pulse to indicate waiting/idle -->
								<DataTrigger Binding="{Binding ConnectionState}" Value="Stale">
									<Setter Property="Fill" Value="#FBC02D" />
									<DataTrigger.EnterActions>
										<BeginStoryboard>
											<Storyboard RepeatBehavior="Forever">
												<DoubleAnimation Storyboard.TargetProperty="Opacity"
												                 From="1.0" To="0.4"
												                 Duration="0:0:1.5"
												                 AutoReverse="True">
													<DoubleAnimation.EasingFunction>
														<CubicEase EasingMode="EaseInOut" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
											</Storyboard>
										</BeginStoryboard>
									</DataTrigger.EnterActions>
								</DataTrigger>

								<!-- Green (Connected) - fast smooth pulse to show activity -->
								<DataTrigger Binding="{Binding ConnectionState}" Value="Connected">
									<Setter Property="Fill" Value="#4CAF50" />
									<DataTrigger.EnterActions>
										<BeginStoryboard>
											<Storyboard RepeatBehavior="Forever">
												<DoubleAnimation Storyboard.TargetProperty="Opacity"
												                 From="1.0" To="0.5"
												                 Duration="0:0:0.8"
												                 AutoReverse="True">
													<DoubleAnimation.EasingFunction>
														<CubicEase EasingMode="EaseInOut" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
											</Storyboard>
										</BeginStoryboard>
									</DataTrigger.EnterActions>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Ellipse.Style>
				</Ellipse>
			</Grid>

			<!-- Character + Map -->
			<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
				<TextBlock Text="{Binding CharacterName}" FontWeight="SemiBold" />
				<TextBlock Text="   " />
				<TextBlock Text="{Binding MapText}" Opacity="0.85" />
			</StackPanel>

			<!-- Coordinates: separate fields for readability -->
			<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
				<TextBlock Text="{Binding XText}" Margin="0,0,12,0" />
				<TextBlock Text="{Binding YText}" Margin="0,0,12,0" />
				<TextBlock Text="{Binding ZText}" />
			</StackPanel>

			<!-- Social links: Website, Discord, GitHub -->
			<StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
				<!-- Update notification (visible only when update is available) -->
				<Button Style="{StaticResource MaterialDesignRaisedButton}"
				        Command="{Binding OpenLatestReleaseCommand}"
				        ToolTip="Click to view the latest release"
				        Height="28"
				        Padding="12,4"
				        Margin="0,0,12,0"
				        Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon Kind="Update" Width="16" Height="16" Margin="0,0,6,0" />
						<TextBlock Text="A newer version is ready!" FontSize="12" />
					</StackPanel>
				</Button>

				<!-- Download GW2 Data button -->
				<Button Style="{StaticResource MaterialDesignToolForegroundButton}"
				        Command="{Binding DownloadGw2DataCommand}"
				        ToolTip="Download GW2 maps and continents data"
				        Height="28" Width="28"
				        Padding="0"
				        Margin="4,0">
					<materialDesign:PackIcon Kind="Download" Width="16" Height="16" />
				</Button>

				<!-- Website button -->
				<Button Style="{StaticResource MaterialDesignToolForegroundButton}"
				        Command="{Binding OpenWebsiteCommand}"
				        ToolTip="Visit KXTools Website"
				        Height="28" Width="28"
				        Padding="0"
				        Margin="4,0">
					<materialDesign:PackIcon Kind="Web" Width="16" Height="16" />
				</Button>

				<!-- Discord button -->
				<Button Style="{StaticResource MaterialDesignToolForegroundButton}"
				        Command="{Binding OpenDiscordCommand}"
				        ToolTip="Join our Discord"
				        Height="28" Width="28"
				        Padding="0"
				        Margin="4,0">
					<materialDesign:PackIcon Kind="Forum" Width="16" Height="16" />
				</Button>

				<!-- GitHub button -->
				<Button Style="{StaticResource MaterialDesignToolForegroundButton}"
				        Command="{Binding OpenGitHubCommand}"
				        ToolTip="View on GitHub"
				        Height="28" Width="28"
				        Padding="0"
				        Margin="4,0">
					<materialDesign:PackIcon Kind="Github" Width="16" Height="16" />
				</Button>
			</StackPanel>
		</Grid>
	</Border>
</UserControl>